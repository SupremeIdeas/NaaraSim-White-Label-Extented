APP_NAME=NaaraSim
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (blueprint: MySQL 8, utf8mb4, strict mode) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=naarasim
DB_USERNAME=root
DB_PASSWORD=

# --- Cache / session / queue drivers ---
# The web installer sets these three for you based on the hosting type you pick:
#   Shared / cPanel (no Redis)  ->  database  (a single cron drives the queue)
#   VPS / Cloud                 ->  redis     (Horizon runs the workers)
# The defaults below are the shared-hosting profile so a fresh clone works on
# the widest range of hosts. On a VPS, switch the three to `redis`.
#
# SESSION_DRIVER must NOT be `file`: the file driver holds an exclusive lock on
# the user's session file for the whole request, so one slow request (e.g. a
# provider call) blocks every other request from that same user until it
# resolves — the whole session appears frozen, not just one widget. `database`
# (or `redis`) releases far faster and never blocks on a hung file handle. The
# provider HTTP timeouts are the other half of this fix (they cap how long any
# request can hold the lock at all).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Default to the local `public` disk so a fresh install's file uploads work with
# ZERO Wasabi keys. MediaStorage auto-upgrades to Wasabi the moment WASABI_* keys
# are filled in — Wasabi is opt-in, not a prerequisite for uploads to work.
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

HORIZON_PREFIX=naarasim_horizon:

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAILGUN_SECRET=

# --- Wasabi S3 object storage (all uploads; never local disk) ---
WASABI_ACCESS_KEY_ID=
WASABI_SECRET_ACCESS_KEY=
WASABI_DEFAULT_REGION=us-east-1
WASABI_BUCKET=naarasim-prod
WASABI_ENDPOINT=https://s3.wasabisys.com
WASABI_USE_PATH_STYLE_ENDPOINT=false

# --- Cloudflare R2 object storage (optional; BUILD-11 §4) ---
# S3-compatible. Leave blank to keep Wasabi / the server disk. These can also
# be pasted in Admin → API keys → Media storage instead of editing this file.
# Endpoint is https://<ACCOUNT_ID>.r2.cloudflarestorage.com (region is "auto").
# R2_PUBLIC_URL is the bucket's public r2.dev URL or a custom domain used to
# SERVE files — required before R2 can hold PUBLIC media. Admin → API keys also
# has a "Primary media store" chooser (auto → R2 → Wasabi → server).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_USE_PATH_STYLE_ENDPOINT=false

# --- Security hardening (blueprint Section 30) ---
# Session: encrypt at rest, HTTPS-only + HttpOnly + SameSite cookies. Set
# SESSION_SECURE_COOKIE=true in production (behind HTTPS).
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Content-Security-Policy + HSTS (both on by default; tune the policy if needed).
SECURITY_CSP_ENABLED=true
SECURITY_HSTS_ENABLED=true
# Extra hostnames the server may fetch despite the SSRF private-range block.
SSRF_ALLOWED_HOSTS=

# --- Support & niche edge (blueprint Section 32) ---
# WhatsApp number in international format, digits only (blank hides the button).
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=support@naarasim.com

# --- Claude-assisted maintenance loop (blueprint Section 29) ---
# The loop reads the error log, asks Claude for a minimal fix, and (on
# super-admin approval) opens a CI-gated PR. It never touches secrets and never
# commits to the default branch. All keys optional — the feature reports
# "not configured" until they are set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Fine-grained GitHub token scoped to THIS repo only (contents + pull-requests
# write). Store encrypted at rest; never commit it.
GITHUB_MAINTENANCE_TOKEN=
GITHUB_MAINTENANCE_REPO=
GITHUB_MAINTENANCE_BASE_BRANCH=main

# --- Database backups (blueprint Section 28) ---
# Password used to AES-encrypt every backup archive. Set a strong value in
# production; leave blank only for local/dev. Backups go to Wasabi when its keys
# are set (below), otherwise to the server's local disk.
BACKUP_ARCHIVE_PASSWORD=

# --- Admin panel security (blueprint Section 25) ---
# Change ADMIN_PATH in production to a non-guessable value — the admin panel is
# mounted here and has zero links from the user UI.
ADMIN_PATH=adminmaster
# Optional comma-separated IP allow-list; blank = any IP (role + 2FA still apply).
ADMIN_IP_ALLOWLIST=
# Force admins to enrol in TOTP 2FA before the panel opens. OFF by default so a
# fresh install is never a silent lockout — a super_admin turns this on from the
# admin Security page once they've enrolled an authenticator.
ADMIN_REQUIRE_2FA=false
# Requests/minute against the admin area (per admin identity, falls back to IP).
ADMIN_THROTTLE=60

# --- AWS block kept for the default s3 disk (unused; Wasabi is primary) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =====================================================================
#  Provider keys (blueprint Section 21). SANDBOX only until Module 12.
#  Any left blank simply show "Coming Soon" until filled (Section 22.1).
# =====================================================================

# eSIM providers
ESIMGO_API_KEY=
ESIMGO_WEBHOOK_SECRET=
ESIMGO_SANDBOX=true
AIRALO_CLIENT_ID=
AIRALO_CLIENT_SECRET=
AIRALO_SANDBOX=true
QUIBITY_API_KEY=
QUIBITY_SANDBOX=true
# BUILD-18 provider expansion — blank = provider shows disabled in admin.
ESIMACCESS_API_KEY=
UBIGI_API_KEY=
# Full-eSIM lane (Naara Connect: calls + data) — Zendit is also a 4th
# data-only fallback; audit found these active chain members undocumented.
ZENDIT_API_KEY=
ZENDIT_SANDBOX=true
ONEGLOBAL_CLIENT_ID=
ONEGLOBAL_CLIENT_SECRET=
ONEGLOBAL_SANDBOX=true
MONTYMOBILE_API_KEY=
MONTYMOBILE_SANDBOX=true
GIGS_API_KEY=
GIGS_PROJECT=
GIGS_SANDBOX=true
# Connectivity Analytics usage-snapshot polling cadence (minutes; default 15).
ESIM_USAGE_SYNC_INTERVAL_MINUTES=15

# Number / SMS providers
GETATEXT_API_KEY=
GETATEXT_WEBHOOK_URL=
FIVESIM_API_KEY=
SMSACTIVATE_API_KEY=
# HeroSMS (primary) / VirtSMS (fallback) — replaced SMS-Activate above (shut
# down; kept the legacy handler_api.php protocol both providers still use).
HEROSMS_API_KEY=
VIRTSMS_API_KEY=
TELNYX_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio Voice (in-browser dialer) — API key pair + TwiML app + outbound caller ID.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=
# Getatext inbound-webhook verification token.
GETATEXT_WEBHOOK_TOKEN=
# BUILD-18 provider expansion — blank = provider shows disabled in admin.
SMSPOOL_API_KEY=
ONLINESIM_API_KEY=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# Plivo inbound-webhook verification token (same scheme as Getatext above).
PLIVO_WEBHOOK_TOKEN=
# Sonetel is OAuth2 password-grant, not a static key (owner audit, 2026-09-15).
SONETEL_USERNAME=
SONETEL_PASSWORD=
SONETEL_ACCOUNT_ID=
# Prompt 12 §2 — Vonage (permanent numbers + voice/SMS).
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_WEBHOOK_TOKEN=
# Prompt 12 §3 — Sinch. Numbers API and SMS API are separate sub-products
# with separate credentials on the Sinch dashboard.
SINCH_CLIENT_ID=
SINCH_CLIENT_SECRET=
SINCH_PROJECT_ID=
SINCH_API_TOKEN=
SINCH_SERVICE_PLAN_ID=
SINCH_WEBHOOK_TOKEN=

# Gift cards — blank = provider shows disabled in admin.
BITREFILL_API_ID=
BITREFILL_API_SECRET=
TILLO_API_KEY=
TILLO_SECRET=
# Reloadly (gift cards + airtime) — OAuth client-credentials pair.
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=

# WhatsApp Autopilot (Meta WhatsApp Cloud API) — see docs/WHATSAPP-AUTOPILOT.md
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_AUTOPILOT_ENABLED=true

# AI
ANTHROPIC_API_KEY=

# Payments (public keys are for client-side inline/embedded checkout)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# Flutterwave webhook verification (dashboard → Settings → Webhooks → Secret Hash).
FLUTTERWAVE_SECRET_HASH=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
# Stripe webhook signing secrets — checkout events and Connect account.updated
# events use SEPARATE endpoints/secrets in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# PayPal — webhook_id is required for secure webhook signature verification
# (developer.paypal.com → Apps & Credentials → your app → Webhooks).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Cryptomus (BUILD-18 crypto pay-in + payout) — blank = disabled in admin.
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=
CRYPTOMUS_PAYOUT_API_KEY=
# Binance Pay (crypto pay-in) — blank = disabled in admin.
BINANCE_PAY_API_KEY=
BINANCE_PAY_API_SECRET=
# NOWPayments (crypto pay-in) — blank = disabled in admin.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# CoinPayments (crypto pay-in) — blank = disabled in admin.
COINPAYMENTS_PUBLIC_KEY=
COINPAYMENTS_PRIVATE_KEY=
COINPAYMENTS_IPN_SECRET=
COINPAYMENTS_MERCHANT_ID=
# Payssion (local payment methods) — blank = disabled in admin.
PAYSSION_API_KEY=
PAYSSION_SECRET_KEY=

# Bot protection (Cloudflare Turnstile) — Module 33. Also settable from the
# admin API-keys page; flip it on from Admin → Security once both are set.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Push
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# Error tracking
SENTRY_LARAVEL_DSN=

# Transactional mail providers (used when MAIL_MAILER=postmark|resend).
POSTMARK_TOKEN=
RESEND_KEY=

# Ops / integrations
# Slack ops notifications (Laravel Slack notification channel).
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=
# Offerwall postback verification secret (rewards).
OFFERWALL_POSTBACK_SECRET=
# App Studio (Section 21) — shared secret the CI export callback is signed with.
APPEXPORT_CI_SECRET=
# Codemagic REST API token (x-auth-token) — only needed for the iOS CI
# provider when App Builder's iOS CI provider is set to "Codemagic".
# codemagic.io -> Teams -> Personal Access Tokens.
CODEMAGIC_API_TOKEN=
# GitHub PAT that fires the repo's own android-build.yml via
# repository_dispatch (Android builds run on GitHub Actions, not Codemagic —
# docs/APP-EXPORT.md). Fine-grained PAT scoped to THIS repo only, with
# "Contents: read" + "Actions: write" permissions — nothing more.
# github.com/settings/personal-access-tokens/new
APPEXPORT_GITHUB_TOKEN=

# Platform updater / white-label license system (Updater Batches 1-5).
# Ed25519 PUBLIC verification key for signed `.naaraupdate` packages — MUST be
# the exact same key the original NaaraSim platform signs with (this is what
# proves a downloaded package genuinely came from the real distribution
# service, not a tampered/spoofed source). Never generate your own keypair on
# a white-label fork.
NAARA_UPDATE_PUBLIC_KEY=
# This is a white-label subscriber — never naarasim-core here.
NAARA_UPDATE_PRODUCT=naarasim-whitelabel
# The original NaaraSim platform's base URL — where this instance checks for
# and downloads updates/themes, and reports apply outcomes (Batch 5).
NAARA_ORIGINAL_PLATFORM_URL=
# This instance's Sanctum API token, issued at registration (Batch 6),
# scoped to updates.check/download + themes.check/download. Never commit a
# real value here — set it only in the deployed .env.
NAARA_UPDATE_API_TOKEN=

VITE_APP_NAME="${APP_NAME}"
